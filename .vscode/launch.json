                "${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-controls/23.0.2/javafx-controls-23.0.2-win.jar",
                "${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-fxml/23.0.2/javafx-fxml-23.0.2-win.jar",
